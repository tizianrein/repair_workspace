GEMINI_API_KEY=your-google-ai-key-here
VITE_COLLAB_API_URL=https://repair-workspace-collaboration.familie-rein.workers.dev

# Server-side copy of the collaboration worker URL. The chat endpoint uses it to
# fetch a corpus document's full text when the model asks for one — the VITE_
# variable above is inlined into the browser bundle and is not visible to
# serverless functions, so both are needed. Set this in Vercel too.
COLLAB_API_URL=https://repair-workspace-collaboration.familie-rein.workers.dev
