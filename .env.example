GEMINI_API_KEY=your-google-ai-key-here

# Where the Cloudflare collaboration worker lives — projects, participant
# layers and the corpus.
#
# LOCAL DEV: leave this UNSET. Unset means the browser calls /api/collaboration,
# which vite.config.js proxies to your local worker on :8787. Setting it points
# local development at production data.
#
# PRODUCTION: set it in Vercel. The deployed site and the worker are on
# different origins, so the browser needs the absolute address, and Vite inlines
# VITE_-prefixed variables into the bundle at build time. The serverless
# functions read the same variable at runtime, so it only needs setting once.
VITE_COLLAB_API_URL=https://repair-workspace-collaboration.familie-rein.workers.dev
